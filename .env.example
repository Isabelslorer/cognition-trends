# Nothing is required by default: the pipeline uses your Claude Code login via the Claude Agent SDK.
# (Run `claude` and /login once.)

# To pay per token with your own key instead, uncomment both. Get a key at https://platform.claude.com/settings/keys
# CLAUDE_BACKEND=api
# ANTHROPIC_API_KEY=

# Optional model overrides (any Claude model id that supports structured outputs)
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_SYNTH_MODEL=claude-sonnet-5-5
