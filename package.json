{
  "name": "miro-claude-dashboard",
  "private": true,
  "description": "Fill the Miro dashboard from an exported Claude conversation history.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "parse": "node pipeline/parse-export.mjs",
    "analyze": "node pipeline/analyze.mjs",
